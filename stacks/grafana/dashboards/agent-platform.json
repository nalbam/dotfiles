      "id": 6,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "node_load1{job=\"integrations/node_exporter\",instance=~\"$instance\"}", "refId": "A" }
      ],
      "title": "Load 1m",
      "type": "stat"
    },
