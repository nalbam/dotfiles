        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"integrations/node_exporter\",instance=~\"$instance\"} / node_memory_MemTotal_bytes{job=\"integrations/node_exporter\",instance=~\"$instance\"})", "refId": "A" }
      ],
      "title": "Memory Usage",
      "type": "gauge"
    },
