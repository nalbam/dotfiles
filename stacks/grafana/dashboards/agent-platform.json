          "decimals": 1,
          "max": 100,
          "min": 0,
          "mappings": [{ "options": { "match": "null", "result": { "text": "N/A" } }, "type": "special" }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 65 }, { "color": "red", "value": 90 }] },
