      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "max(up{job=\"agent-studio\",instance=~\"$instance\"})", "legendFormat": "Agent Studio", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "max(up{job=\"agent-memory\",instance=~\"$instance\"})", "legendFormat": "Agent Memory", "refId": "B" }
