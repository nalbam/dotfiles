[core]
  untrackedCache = true
  autocrlf = input
  pager =
  precomposeunicode = true
  quotepath = false

[apply]
  whitespace = fix

[branch]
  sort = -committerdate

[color]
  ui = auto

[pull]
  # rebase = true
  ff = only

[push]
  default = simple
  followTags = true

[init]
  defaultBranch = main

[user]
  name = nalbam
  email = me@nalbam.com

[includeIf "gitdir:~/workspace/github.com/nalbam/"]
  path = .gitconfig-nalbam
[includeIf "gitdir:~/workspace/github.com/opspresso/"]
  path = .gitconfig-nalbam
[includeIf "gitdir:~/workspace/github.com/yujh404/"]
  path = .gitconfig-yujh404
[includeIf "gitdir:~/workspace/github.com/nalbam-me/"]
  path = .gitconfig-nalbam-me
[includeIf "gitdir:~/workspace/github.com/nalbam-bot/"]
  path = .gitconfig-nalbam-bot
