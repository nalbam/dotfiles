{
  "cleanupPeriodDays": 3650,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ENABLE_TOOL_SEARCH": "1"
  },
  "permissions": {
    "allow": [
      "Skill(*)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(chmod -R 777 /:*)",
      "Bash(chown -R * /:*)",
      "Bash(curl * | sh:*)",
      "Bash(curl * | bash:*)",
      "Bash(dd if=/dev/zero:*)",
      "Bash(fdisk:*)",
      "Bash(gdisk:*)",
      "Bash(halt:*)",
      "Bash(init 0:*)",
      "Bash(init 6:*)",
      "Bash(mkfs:*)",
      "Bash(parted:*)",
      "Bash(poweroff:*)",
      "Bash(reboot:*)",
      "Bash(rm -rf $HOME/*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/*)",
      "Bash(shutdown:*)",
      "Bash(sudo rm -rf:*)",
      "Bash(systemctl disable:*)",
      "Bash(systemctl halt:*)",
      "Bash(systemctl poweroff:*)",
      "Bash(systemctl reboot:*)",
      "Bash(systemctl stop:*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/memory-sync.sh start",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/memory-sync.sh end",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "frontend-design@claude-plugins-official": true,
    "linear@claude-plugins-official": false,
    "notion@claude-plugins-official": false,
    "playwright@claude-plugins-official": false,
    "slack@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "theme": "auto",
  "skillOverrides": {
    "find-skills": "off"
  }
}
