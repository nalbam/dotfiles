# AWS Vault helper function
av() {
  if [ $# -eq 0 ]; then
    if command -v fzf >/dev/null 2>&1; then
      local profiles
      profiles=$(aws-vault list) || return
      profiles=$(printf '%s\n' "$profiles" | awk 'NR>2 && $1 ~ /^[a-zA-Z]/ {print $1}')
      if [ -z "$profiles" ]; then
        echo "No aws-vault profiles found"
        return 1
      fi

      local selected
      selected=$(printf "%s\n[clear credentials]" "$profiles" | fzf \
        --prompt="aws-vault > " \
        --height=40% \
        --layout=reverse \
        --border \
        --no-sort)

      [ -z "$selected" ] && return

      case "$selected" in
        "[clear credentials]")
          aws-vault clear
          ;;
        *)
          export AWS_VAULT=
          aws-vault exec "$selected"
          ;;
      esac
    else
      echo "aws-vault profiles:"
      echo "  n|nalbam - nalbam"
      echo "  t|two    - nalbam-two"
      echo "  k|krug   - awskrug-team"
      echo "  o|ops    - opspresso"
      echo "Commands: c|clear, l|list"
    fi
    return
  fi

  local profile
  case "$1" in
    n|nalbam) profile=nalbam ;;
    t|two)    profile=nalbam-two ;;
    k|krug)   profile=awskrug-team ;;
    o|ops)    profile=opspresso ;;
    c|clear)  aws-vault clear; return ;;
    l|list)   aws-vault list; return ;;
    *)        export AWS_VAULT= && aws-vault exec "$@"; return ;;
  esac
  shift
  export AWS_VAULT=
  aws-vault exec "$profile" -- "$@"
}

