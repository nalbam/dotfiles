# AWS Vault helper function
av() {
  if [ $# -eq 0 ]; then
    if command -v fzf &>/dev/null; then
      # Try to get profiles from aws-vault, fall back to hardcoded list
      local profiles
      profiles=$(aws-vault list 2>/dev/null | awk 'NR>2 && $1 ~ /^[a-zA-Z]/ {print $1}')
      if [ -z "$profiles" ]; then
        profiles="nalbam
nalbam-two
awskrug-team
opspresso"
      fi

      local selected
      selected=$(printf "%s\n[clear credentials]" "$profiles" | fzf \
        --prompt="aws-vault > " \
        --height=40% \
        --layout=reverse \
        --border \
        --no-sort)

      [ -z "$selected" ] && return

      case "$selected" in
        "[clear credentials]")
          aws-vault clear
          ;;
        *)
          export AWS_VAULT=
          aws-vault exec "$selected"
          ;;
      esac
    else
      echo "aws-vault profiles:"
      echo "  n|nalbam - nalbam"
      echo "  t|two    - nalbam-two"
      echo "  k|krug   - awskrug-team"
      echo "  o|ops    - opspresso"
      echo "Commands: c|clear, l|list"
    fi
    return
  fi

  case "$1" in
    n|nalbam) export AWS_VAULT= && aws-vault exec nalbam -- ${@:2} ;;
    t|two)    export AWS_VAULT= && aws-vault exec nalbam-two -- ${@:2} ;;
    k|krug)   export AWS_VAULT= && aws-vault exec awskrug-team -- ${@:2} ;;
    o|ops)    export AWS_VAULT= && aws-vault exec opspresso -- ${@:2} ;;
    c|clear)  aws-vault clear ;;
    l|list)   aws-vault list ;;
    *)        export AWS_VAULT= && aws-vault exec "$@" ;;
  esac
}

