# Node.js / JavaScript / TypeScript
# Detect package manager: package.json "packageManager" field, else lock file
np() {
  local pm=""
  if [ -f "package.json" ]; then
    pm=$(node -p "(require('./package.json').packageManager || '').split('@')[0]" 2>/dev/null)
  fi
  case "$pm" in
    pnpm | npm | yarn) echo "$pm" ;;
    *)
      if [ -f "pnpm-lock.yaml" ]; then
        echo "pnpm"
      elif [ -f "yarn.lock" ]; then
        echo "yarn"
      else
        echo "npm"
      fi
      ;;
  esac
}
nn() {
  case "$(np)" in
    pnpm)
      echo "Reinstalling from pnpm lockfile..."
      rm -rf node_modules .next && pnpm install --frozen-lockfile
      ;;
    yarn)
      echo "Reinstalling from yarn lockfile..."
      rm -rf node_modules dist && yarn install --frozen-lockfile
      ;;
    *)
      echo "Reinstalling from npm lockfile..."
      rm -rf node_modules dist && npm ci
      ;;
  esac
}
nnn() {
  case "$(np)" in
    pnpm)
      echo "Installing fresh versions with pnpm..."
      rm -rf node_modules pnpm-lock.yaml .next && pnpm install
      ;;
    yarn)
      echo "Installing fresh versions with yarn..."
      rm -rf node_modules yarn.lock dist && yarn install
      ;;
    *)
      echo "Installing fresh versions with npm..."
      rm -rf node_modules package-lock.json dist && npm install
      ;;
  esac
}
nb() {
  case "$(np)" in
    pnpm) echo "Building with pnpm..."; pnpm build ;;
    yarn) echo "Building with yarn..."; yarn build ;;
    *) echo "Building with npm..."; npm run build ;;
  esac
}

